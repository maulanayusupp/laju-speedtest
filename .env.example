# Public site URL (used by SEO, sitemap, hreflang and OG tags)
NUXT_PUBLIC_SITE_URL=https://laju-speedtest.vercel.app

# Contact channels shown on the contact page (written channels only)
NUXT_PUBLIC_CONTACT_EMAIL=maulanayusupp@gmail.com
NUXT_PUBLIC_WHATSAPP=6287822766333

# IPv4-only / IPv6-only echo endpoints called from the BROWSER so both address
# families can be shown. Our own origin can only ever observe one of them.
# Both defaults are plain-text, CORS-enabled endpoints. Set to an empty value to
# disable the third-party lookup entirely (the page then shows only the address
# our own server observes).
NUXT_PUBLIC_IPV4_PROBE=https://ipv4.icanhazip.com
NUXT_PUBLIC_IPV6_PROBE=https://ipv6.icanhazip.com
